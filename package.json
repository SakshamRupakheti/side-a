{
  "name": "side-a-diary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "wrangler d1 migrations apply side-a --local",
    "build": "vite build",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.0",
    "wrangler": "4.164.0"
  }
}
