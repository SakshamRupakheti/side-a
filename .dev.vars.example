BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
LOCAL_PASSWORD_AUTH=true
# Optional in development. Configure at least one provider in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
# Set true to pause search and provider requests while keeping manual saves available.
DISABLE_LOOKUPS=false
# Hosted publisher lookups require verified permission and an existing supported hostname.
PUBLISHER_METADATA_HOSTS=
# Leave rich API credentials empty on the zero-dollar launch. Basic Spotify and YouTube imports work without these.
YOUTUBE_DATA_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

